{
  "uid": "lung-cancer-ai-platform",
  "title": "Lung Cancer AI Platform",
  "description": "Real-time monitoring for the Lung Cancer AI Platform",
  "tags": [
    "lung-cancer",
    "ai",
    "medical-imaging"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "\ud83e\udde0 Inference Metrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inference Latency (ms)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lung_cancer_inference_latency_ms_bucket[5m])) by (le, model))",
          "legendFormat": "p95 {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Inferences",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(lung_cancer_inference_total[1h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Active Cases",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "lung_cancer_active_cases",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "\ud83d\udcca Model Performance",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model AUC (auc)",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "lung_cancer_model_accuracy{metric=\"auc\"}",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model SENSITIVITY (sensitivity)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "lung_cancer_model_accuracy{metric=\"sensitivity\"}",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model SPECIFICITY (specificity)",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "lung_cancer_model_accuracy{metric=\"specificity\"}",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "\ud83c\udfcb\ufe0f Training Pipeline",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Training Loss (train vs val)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lung_cancer_training_epoch_loss",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Training AUC (train vs val)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "lung_cancer_training_epoch_auc",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "\ud83d\udda5\ufe0f Infrastructure",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU Memory (bytes)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "lung_cancer_gpu_memory_bytes",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API Request Rate (req/s)",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(lung_cancer_inference_total{model=\"http\"}[1m])",
          "legendFormat": "{{model}} {{split}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 15,
      "type": "piechart",
      "title": "DICOM QA Outcomes",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "lung_cancer_dicom_validation_total",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "__requires": [
    {
      "type": "datasource",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ]
}