# =============================================================================
#  LUNG CANCER AI RESEARCH PLATFORM — Environment Configuration Template
#  Copy this file to .env and populate with your secure, environment-specific values.
#  DO NOT COMMIT .env OR ANY FILE CONTAINING REAL SECRETS TO VERSION CONTROL.
# =============================================================================

# --- Backend Application Security ---
SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/lung_platform.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://your-deployed-site.example.com

# --- Optional Model Weights Auto-Download (Checkpoints_3d) ---
# If required weights are missing on boot and URL is defined, backend downloads them with size verification
WEIGHTS_URL_ORIGINAL=
WEIGHTS_URL_FINETUNED=

# --- Observability & Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# --- AI & LLM Provider Keys (Used exclusively server-side via backend proxy) ---
# Never expose these keys in frontend bundles or client-side code
ENABLE_CLOUD_AI=false
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Cloud & Storage Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# --- Dataset Paths ---
# Path to official LUNA16 dataset root (must be located outside OneDrive / excluded from sync)
LUNA16_ROOT=
