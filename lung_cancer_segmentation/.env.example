# ──────────────────────────────────────────────
# Environment variables — PulmoTrust AI
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Anthropic Claude API — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use (claude-sonnet-4-5 is fast & accurate for clinical use)
CLAUDE_MODEL=claude-sonnet-4-5

# ──────────────────────────────────────────────
# App settings (defaults shown — change as needed)
# ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production-super-secret-key-2024
DATABASE_URL=sqlite:///./lung_seg.db
REDIS_URL=redis://localhost:6379/0
DEBUG=false
